# Rust / Tauri
src-tauri/target/
# tauri 生成的 schema，构建时自动重建
src-tauri/gen/

# Node
node_modules/

# 临时验证脚本（按项目规则用完即删，不入库）
tmp_verify_*

# 个人游戏截图（调样式用的开发资源）
devdata/

# Python
__pycache__/

# 杂项
*.log

# 站点组装产物，由 tools/build_site.py 生成
dist/

# Claude Code 的本地配置（如内置浏览器启动回放服务器的 launch.json），只在本机有意义
.claude/
